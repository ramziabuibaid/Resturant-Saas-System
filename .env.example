# Supabase — استبدل القيم بمشروعك من لوحة Supabase → Settings → API
# Project URL: https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# مفتاح service_role (للخادم فقط — لا ترفعه إلى Git أبداً)
# من Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# الدومين الرئيسي للمنصة بدون https (مثل menu.app). المطاعم تصبح alking.menu.app
# اتركه فارغاً محلياً — يُستخدم alking.localhost:3000 تلقائياً.
NEXT_PUBLIC_ROOT_DOMAIN=
