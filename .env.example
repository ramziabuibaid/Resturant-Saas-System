# قاعدة البيانات PostgreSQL. محلياً: npm run db:start ثم هذا الرابط كما هو.
DATABASE_URL=postgres://postgres@localhost:5442/restaurant_saas

# الدومين الرئيسي للمنصة بدون https (مثل resturant.app). المطاعم تصبح alking.resturant.app
# اتركه فارغاً محلياً — يُستخدم alking.localhost:3000 تلقائياً.
NEXT_PUBLIC_ROOT_DOMAIN=

# رقم واتساب الدعم (دولي، أرقام فقط مثل 970599123456) — زر «جدّد الاشتراك» في لوحة المطعم.
# على السيرفر يُضبط باسم SUPPORT_WHATSAPP في .env ويُضمَّن وقت البناء.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# البريد عبر Resend (اختياري) — بدونه تُطبع الرسائل في السجل فقط
# RESEND_API_KEY=re_...
# EMAIL_FROM=منيو <noreply@resturant.app>
# EMAIL_REPLY_TO=you@example.com

# دخول Google (اختياري) — بدونه يُخفى الزر. Redirect URI: <الدومين>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# رابط المنصة في البريد ومسار Google (اختياري؛ الافتراضي https://NEXT_PUBLIC_ROOT_DOMAIN)
# APP_URL=http://localhost:3001

# مجلد الصور المرفوعة (اختياري). الافتراضي: ./uploads — على السيرفر يكون Docker volume.
# UPLOAD_DIR=/data/uploads

# بذرة القاعدة (npm run db:seed) — اختياري
# SEED_ADMIN_EMAIL=admin@resturant.app
# SEED_ADMIN_PASSWORD=
